pipeline {
    agent {label 'master'}

    triggers {
        cron('0 12 * * *') 
    }

    stages {
        stage('Backup Jenkins Home') {
            steps {
                script {
                   
                    def timestamp = sh(returnStdout: true, script: 'date +%Y-%m-%d_%H-%M-%S').trim()
                    
                    
                    def backupFolder = "/backup/jenkins_home_backup_${timestamp}"
                    
                    sh "mkdir -p /backup"
                   
                    sh "tar -czf ${backupFolder}.tar.gz ${JENKINS_HOME}"
                    
                    echo "Backup created at: ${backupFolder}.tar.gz"
                }
            }
        }
    }
}