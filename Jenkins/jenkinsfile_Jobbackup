pipeline {
    agent { label 'master' }

    triggers {
        cron('0 12 * * *')
    }

    stages {
        stage('Backup Jenkins Jobs') {
            steps {
                script {

                   
                    def timestamp = sh(script: "date +%Y-%m-%d_%H-%M-%S", returnStdout: true).trim()

                    def backupFolder = "/backup/jenkins_jobs_backup_${timestamp}"

                    sh "mkdir -p ${backupFolder}"
                    
                    sh "cp -r /var/lib/jenkins/jobs/* ${backupFolder}"
                    
                    echo "Jobs backup created at: ${backupFolder}"
                    
                    sh "ls -l ${backupFolder}"

                }
            }
        }
    }
}